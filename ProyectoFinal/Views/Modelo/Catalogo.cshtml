@model IEnumerable<ProyectoFinal.Models.Modelo>

<link rel="stylesheet" href="~/css/amigurumis.css" />

<h2 class="titulo">Catálogo de amigurumis</h2>

<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:16px">
    @foreach (var m in Model)
    {
        <div class="card-modelo">
            <img src="@m.Imagen" />
            <div class="cuerpo">
                <strong>@m.Nombre</strong>
                <span class="badge-dificultad @m.Dificultad.ToLower()">@m.Dificultad</span>
                <p>@m.Descripcion</p>

                <p style="font-size:12px;color:#999;margin:4px 0">
                    Tiempo de producción: @m.TiempoProduccion h
                </p>

                <div class="tabla-precios">
                    <div class="fila"><span>Precio venta</span><span>Bs @m.PrecioVenta</span></div>
                    <div class="fila"><span>Costo</span><span>Bs @m.Costo</span></div>
                    <div class="fila utilidad"><span>Utilidad</span><span>Bs @m.Utilidad</span></div>
                </div>

                <div style="margin-top:10px;border-top:1px solid var(--gris);padding-top:8px">
                    <p style="font-size:12px;color:#999;margin:0 0 4px;font-weight:700">Materiales usados</p>

                    @if (m.ModeloMateriales != null && m.ModeloMateriales.Any())
                    {
                        <ul style="font-size:12px;color:#555;margin:0;padding-left:16px">
                            @foreach (var mm in m.ModeloMateriales)
                            {
                                <li>
                                    @mm.Material.Nombre - @mm.Material.Color
                                    (@mm.Cantidad @mm.Material.UnidadMedida)
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p style="font-size:12px;color:#aaa;margin:0">Sin materiales registrados aún.</p>
                    }
                </div>

                <div style="margin-top:10px;border-top:1px solid var(--gris);padding-top:8px;display:flex;align-items:center;justify-content:space-between">
                    <form asp-action="Agregar" asp-controller="Modelo" asp-route-id="@m.IdModelo" method="post" style="display:flex;align-items:center;gap:6px">
                        @Html.AntiForgeryToken()
                        <input type="number" name="cantidad" value="1" min="1" style="width:50px;padding:2px 4px;border:1px solid var(--gris);border-radius:4px;font-size:12px" />
                        <button type="submit" class="btn-agregar" style="padding:4px 10px;font-size:11px">+ Agregar</button>
                    </form>
                    <span style="font-size:12px;color:#666">Agregado: <strong>@m.VecesAgregado</strong> veces</span>
                </div>
            </div>
        </div>
    }
</div>