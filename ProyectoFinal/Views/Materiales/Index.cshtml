@model IEnumerable<ProyectoFinal.Models.material>

@{
    ViewData["Title"] = "Materiales";
}

<div class="page-header">
    <h1 class="page-title">Gestión de materiales</h1>
    <p class="page-eyebrow">Consulta y administra el stock de materiales para tus amigurumis</p>
</div>

<div class="d-flex justify-content-end mb-3">
    <a asp-action="Create" class="btn-pastel" style="text-decoration:none;display:inline-block;">
        + Registrar nuevo material
    </a>
</div>

<div class="tabla-responsive">
    <table class="tabla-pastel">
        <thead>
            <tr>
                <th>Material</th>
                <th>Tipo</th>
                <th>Color</th>
                <th>Unidad</th>
                <th>Cantidad</th>
                <th>Precio</th>
                <th>Stock mínimo</th>
                <th>Estado</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td style="font-weight:600;">@item.Nombre</td>
                    <td>@item.Tipo</td>
                    <td>@item.Color</td>
                    <td>@item.UnidadMedida</td>
                    <td>@item.CantidadDisponible</td>
                    <td>Bs. @item.PrecioUnitario</td>
                    <td>@item.StockMinimo</td>
                    <td>
                        @if (item.Estado == "stock agotado")
                        {
                            <span class="badge-estado agotado">Sin stock</span>
                        }
                        else if (item.Estado == "stock bajo")
                        {
                            <span class="badge-estado bajo">Stock bajo</span>
                        }
                        else
                        {
                            <span class="badge-estado disponible">Disponible</span>
                        }
                    </td>
                    <td>
                        <div class="icon-actions">
                            <a asp-action="Details" asp-route-id="@item.IdMaterial" class="icon-btn ver" title="Ver">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8Z" />
                                    <circle cx="12" cy="12" r="3" />
                                </svg>
                            </a>
                            <a asp-action="Edit" asp-route-id="@item.IdMaterial" class="icon-btn editar" title="Editar">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M12 20h9" />
                                    <path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z" />
                                </svg>
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.IdMaterial" class="icon-btn eliminar" title="Eliminar">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <polyline points="3 6 5 6 21 6" />
                                    <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" />
                                </svg>
                            </a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
