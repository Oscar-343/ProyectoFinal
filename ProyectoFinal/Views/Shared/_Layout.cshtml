<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Amigurumis Luna</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ProyectoFinal.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/amigurumis.css" asp-append-version="true" />
</head>
<body>
    <div class="app-shell">

        <!-- ===== SIDEBAR ===== -->
        <aside class="sidebar">
            <div class="sidebar-brand">
                <img src="~/images/logo-amigurumis.png" alt="Amigurumis Luna" class="brand-logo" />
                <div class="brand-text">
                    <span class="brand-title">AMIGURUMIS</span>
                    <span class="brand-subtitle">LUNA</span>
                </div>
            </div>

            <div class="sidebar-session">
                <span class="session-dot"></span>
                Sesión activa: <strong>@(Context.Session.GetString("UsuarioLogueado") ?? "Administradora")</strong>
            </div>

            <nav class="sidebar-nav">
                <a class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")"
                   asp-area="" asp-controller="Home" asp-action="Index">
                    Inicio
                </a>

                <a class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Modelo" && ViewContext.RouteData.Values["action"]?.ToString() != "Catalogo" ? "active" : "")"
                   asp-area="" asp-controller="Modelo" asp-action="Index">
                    Modelos
                </a>

                <a class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Materiales" ? "active" : "")"
                   asp-area="" asp-controller="Materiales" asp-action="Index">
                    Materiales
                </a>

                <a class="nav-item @(ViewContext.RouteData.Values["action"]?.ToString() == "Catalogo" ? "active" : "")"
                   asp-area="" asp-controller="Modelo" asp-action="Catalogo">
                    Catálogo
                </a>

                <!-- Dropdown de Pedidos -->
                <div class="nav-group">
                    <button class="nav-item nav-item-toggle" type="button"
                            data-bs-toggle="collapse" data-bs-target="#pedidosSubmenu"
                            aria-expanded="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Pedido" || ViewContext.RouteData.Values["controller"]?.ToString() == "PedidoPersonalizado" ? "true" : "false")"
                            aria-controls="pedidosSubmenu">
                        Pedidos
                        <span class="nav-caret">▾</span>
                    </button>

                    <div class="collapse @(ViewContext.RouteData.Values["controller"]?.ToString() == "Pedido" || ViewContext.RouteData.Values["controller"]?.ToString() == "PedidoPersonalizado" ? "show" : "")" id="pedidosSubmenu">
                        <a class="nav-subitem" asp-controller="Pedido" asp-action="Index">
                            Todos los pedidos
                        </a>
                        <a class="nav-subitem" asp-controller="Pedido" asp-action="Index" asp-route-estado="Pendiente">
                            Pedidos pendientes
                        </a>
                        <a class="nav-subitem" asp-controller="PedidoPersonalizado" asp-action="Index">
                            Pedidos personalizados
                        </a>
                    </div>
                </div>

                <a class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Reporte" ? "active" : "")"
                   asp-area="" asp-controller="Reporte" asp-action="Index">
                    Reportes
                </a>
            </nav>

            <div class="sidebar-footer">
                <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                <span>&copy; 2026 Amigurumis Luna</span>
            </div>
        </aside>

        <!-- Fondo oscuro que aparece detrás del menú cuando está abierto en celular; tocarlo lo cierra. -->
        <div class="sidebar-backdrop" id="sidebarBackdrop"></div>

        <!-- ===== CONTENIDO ===== -->
        <div class="main-wrapper">
            <!-- Barra solo visible en celular/tablet, con el botón para abrir el menú. -->
            <div class="mobile-topbar">
                <button id="sidebarToggle" class="sidebar-toggle" type="button" aria-label="Abrir menú" aria-controls="sidebarNav" aria-expanded="false">
                    ☰
                </button>
                <span class="mobile-topbar-brand">Amigurumis Luna</span>
            </div>

            <main role="main" class="content-area">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
            (function() {
                var appShell = document.querySelector('.app-shell');
                var toggle = document.getElementById('sidebarToggle');
                var backdrop = document.getElementById('sidebarBackdrop');

                function abrirMenu() {
                    appShell.classList.add('sidebar-collapsed');
                    toggle?.setAttribute('aria-expanded', 'true');
                }

                function cerrarMenu() {
                    appShell.classList.remove('sidebar-collapsed');
                    toggle?.setAttribute('aria-expanded', 'false');
                }

                toggle?.addEventListener('click', function() {
                    appShell.classList.contains('sidebar-collapsed') ? cerrarMenu() : abrirMenu();
                });

                // Tocar fuera del menú (el fondo oscuro) lo cierra.
                backdrop?.addEventListener('click', cerrarMenu);

                // En celular, al elegir una opción del menú, se cierra solo.
                document.querySelectorAll('.nav-item:not(.nav-item-toggle), .nav-subitem').forEach(function(link) {
                    link.addEventListener('click', function() {
                        if (window.innerWidth <= 900) cerrarMenu();
                    });
                });
            })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
