@model ProyectoFinal.Models.LoginViewModel

@{
    ViewData["Title"] = "Iniciar Sesión";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>Iniciar Sesión</title>
    <link href="https://fonts.googleapis.com/css2?family=Comfortaa&family=Quicksand&display=swap" rel="stylesheet">
    <style>
            body {
                background-color: #ECECEC;
                font-family: 'Quicksand', sans-serif;
                text-align: center;
                padding-top: 80px;
            }

            h2 {
                font-family: 'Comfortaa', cursive;
                color: #CE93D8;
            }

            .caja-login {
                background-color: #FFF8E1;
                width: 300px;
                margin: auto;
                padding: 30px;
                border-radius: 15px;
            }

            input {
                width: 90%;
                padding: 10px;
                margin-bottom: 15px;
                border: 2px solid #B3E5FC;
                border-radius: 8px;
            }

            button {
                background-color: #F8BBD0;
                padding: 10px 20px;
                border: none;
                border-radius: 8px;
                font-family: 'Comfortaa', cursive;
                cursor: pointer;
            }

            .error {
                color: red;
            }
    </style>
</head>
<body>

    <div class="caja-login">
        <h2>Iniciar Sesión</h2>

        @if (ViewBag.Error != null)
        {
            <p class="error">@ViewBag.Error</p>
        }

        <form asp-controller="Account" asp-action="Login" method="post">
            <label>Usuario</label><br />
            <input asp-for="NombreUsuario" /><br />

            <label>Contraseña</label><br />
            <input asp-for="Password" type="password" /><br />

            <button type="submit">Ingresar</button>
        </form>
    </div>

</body>
</html>