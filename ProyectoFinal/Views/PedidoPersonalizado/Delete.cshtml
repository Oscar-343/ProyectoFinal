@model ProyectoFinal.Models.PedidoPersonalizado

@{
    ViewData["Title"] = "Eliminar pedido personalizado";
}

<div class="page-header">
    <h1 class="page-title">Eliminar pedido personalizado</h1>
    <p class="page-eyebrow">Esta acción no se puede deshacer</p>
</div>

<div class="detalle-box" style="max-width:520px;margin:0 auto">
    @if (!string.IsNullOrEmpty(Model.Imagen))
    {
        <img src="@Model.Imagen" class="detalle-imagen" />
    }

    <div class="caja-peligro">
        ⚠️ ¿Seguro que deseas eliminar el pedido de <strong>@Model.Cliente</strong> (@Model.NombreReferencia)?
    </div>

    <div class="detalle-grid">
        <div class="detalle-item">
            <span class="etiqueta">Precio</span>
            <span class="valor">Bs @Model.PrecioVenta</span>
        </div>
        <div class="detalle-item">
            <span class="etiqueta">Entrega</span>
            <span class="valor">@Model.FechaEntrega.ToString("dd/MM/yyyy HH:mm")</span>
        </div>
    </div>

    <form asp-action="Delete" asp-controller="PedidoPersonalizado" method="post" style="margin-top:18px">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" value="@Model.IdPedidoPersonalizado" />
        <button type="submit" class="btn-peligro">Sí, eliminar</button>
        <a asp-action="Index" asp-controller="PedidoPersonalizado" class="btn-secundario">Cancelar</a>
    </form>
</div>
