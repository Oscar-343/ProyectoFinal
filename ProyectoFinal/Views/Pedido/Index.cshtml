@model List<ProyectoFinal.ViewModels.PedidoResumenViewModel>

@{
    ViewData["Title"] = ViewBag.TituloLista;
}

<div class="page-header">
    <h1 class="page-title">@ViewBag.TituloLista</h1>
    <p class="page-eyebrow">Consulta y administra los pedidos registrados</p>
</div>

<div class="d-flex justify-content-end mb-3">
    <a class="btn-pastel" style="text-decoration:none;display:inline-block;" asp-controller="Pedido" asp-action="Create">
        + Nuevo pedido
    </a>
</div>

@if (TempData["Mensaje"] != null)
{
    <div class="alerta-exito">@TempData["Mensaje"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alerta-error">@TempData["Error"]</div>
}

@if (!Model.Any())
{
    <p class="section-empty">No hay pedidos para mostrar.</p>
}
else
{
    <table class="tabla-pastel">
        <thead>
            <tr>
                <th>Tipo</th>
                <th>Cliente</th>
                <th>Descripción</th>
                <th>Fecha de inicio</th>
                <th>Fecha de entrega</th>
                @if (ViewBag.MostrarTiempoRestante == true)
                {
                    <th>Tiempo restante</th>
                }
                <th>Estado</th>
                <th>Total</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var pedido in Model)
            {
                string estadoClase = pedido.Estado.ToString().ToLowerInvariant();
                string tiempoRestante = ViewBag.MostrarTiempoRestante == true
                    ? CalcularTiempoRestante(pedido.FechaEntrega)
                    : null;

                <tr>
                    <td>
                        @if (pedido.Tipo == "Personalizado")
                        {
                            <span class="badge-tipo personalizado">Personalizado</span>
                        }
                        else
                        {
                            <span class="badge-tipo catalogo">De Catálogo</span>
                        }
                    </td>
                    <td style="font-weight:600;">@pedido.Cliente</td>
                    <td>@pedido.Descripcion</td>
                    <td>@pedido.FechaInicio.ToString("dd/MM/yyyy")</td>
                    <td>@pedido.FechaEntrega.ToString("dd/MM/yyyy")</td>
                    @if (ViewBag.MostrarTiempoRestante == true)
                    {
                        <td>@tiempoRestante</td>
                    }
                    <td>
                        <span class="badge-estado-pedido estado-@estadoClase">@pedido.Estado</span>
                    </td>
                    <td>@pedido.Total.ToString("C")</td>
                    <td>
                        <div class="icon-actions">
                            @{
                                string controlador = pedido.Tipo == "Normal" ? "Pedido" : "PedidoPersonalizado";
                            }
                            <a asp-controller="@controlador" asp-action="Details" asp-route-id="@pedido.Id" class="icon-btn ver" title="Ver">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8Z" />
                                    <circle cx="12" cy="12" r="3" />
                                </svg>
                            </a>
                            <a asp-controller="@controlador" asp-action="Edit" asp-route-id="@pedido.Id" class="icon-btn editar" title="Editar">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M12 20h9" />
                                    <path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z" />
                                </svg>
                            </a>
                            <a asp-controller="@controlador" asp-action="Delete" asp-route-id="@pedido.Id" class="icon-btn eliminar" title="Eliminar">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <polyline points="3 6 5 6 21 6" />
                                    <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" />
                                </svg>
                            </a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@functions {
    string CalcularTiempoRestante(DateTime fechaEntrega)
    {
        var restante = fechaEntrega - DateTime.Now;
        if (restante.TotalHours <= 0) return "Vencido";
        int dias = restante.Days;
        int horas = restante.Hours;
        return dias == 0 ? $"{horas} horas" : $"{dias} días, {horas} horas";
    }
}
