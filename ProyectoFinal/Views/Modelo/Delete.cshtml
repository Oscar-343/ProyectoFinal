@model ProyectoFinal.Models.Modelo

<link rel="stylesheet" href="~/css/amigurumis.css" />

<h2 class="titulo">Eliminar modelo</h2>
<p>¿Seguro que quieres eliminar este modelo?</p>

<div class="card-modelo" style="max-width:260px">
    <img src="@Model.Imagen" />
    <div class="cuerpo">
        <strong>@Model.Nombre</strong>
        <p>@Model.Descripcion</p>
    </div>
</div>

<form asp-action="Delete" method="post" class="mt-3">
    <input type="hidden" asp-for="IdModelo" />
    <button type="submit" class="btn-pastel">Eliminar</button>
    <a asp-action="Index">Cancelar</a>
</form>
