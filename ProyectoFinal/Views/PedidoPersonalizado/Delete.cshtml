@model ProyectoFinal.Models.PedidoPersonalizado

<link rel="stylesheet" href="~/css/amigurumis.css" />

<h2 class="titulo">Eliminar pedido personalizado</h2>

<div style="max-width:500px">
    @if (!string.IsNullOrEmpty(Model.Imagen))
    {
        <img src="@Model.Imagen" style="width:100%;max-height:250px;object-fit:cover;border-radius:8px;margin-bottom:12px" />
    }

    <p style="font-size:14px">
        ¿Seguro que deseas eliminar el pedido de <strong>@Model.Cliente</strong> (@Model.NombreReferencia)?
    </p>
    <p style="font-size:12px;color:#888">Precio: Bs @Model.PrecioVenta — Entrega: @Model.FechaEntrega.ToString("dd/MM/yyyy HH:mm")</p>

    <form asp-action="Delete" asp-controller="PedidoPersonalizado" method="post" style="margin-top:16px">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" value="@Model.IdPedidoPersonalizado" />
        <button type="submit" style="background:#c0392b;color:#fff;padding:8px 16px;border:none;border-radius:4px;cursor:pointer;font-size:13px">
            Eliminar
        </button>
        <a asp-action="Index" asp-controller="PedidoPersonalizado" style="margin-left:10px;font-size:13px">Cancelar</a>
    </form>
</div>
