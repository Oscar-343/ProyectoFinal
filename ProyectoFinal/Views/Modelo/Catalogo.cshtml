@model IEnumerable<ProyectoFinal.Models.Modelo>

@{
    ViewData["Title"] = "Catálogo";
}

@Html.AntiForgeryToken()

<div class="page-header">
    <h1 class="page-title">Catálogo de amigurumis</h1>
    <p class="page-eyebrow">Elige los modelos y cantidades para armar el pedido</p>
</div>

<div class="catalogo-layout">

    <!-- ===== GRID DE MODELOS ===== -->
    <div class="catalogo-grid">
        @foreach (var m in Model)
        {
            <div class="card-modelo">
                <img src="@m.Imagen" />
                <div class="cuerpo">
                    <strong>@m.Nombre</strong>
                    <span class="badge-dificultad @m.Dificultad.ToLower()">@m.Dificultad</span>
                    <p>@m.Descripcion</p>

                    <p style="font-size:12px;color:var(--texto-suave);margin:4px 0">
                        Tiempo de producción: @m.TiempoProduccion h
                    </p>

                    <div class="tabla-precios">
                        <div class="fila"><span>Precio venta</span><span>Bs @m.PrecioVenta</span></div>
                        <div class="fila"><span>Costo</span><span>Bs @m.Costo</span></div>
                        <div class="fila utilidad"><span>Utilidad</span><span>Bs @m.Utilidad</span></div>
                    </div>

                    <div class="materiales-usados">
                        <p class="etiqueta">Materiales usados</p>

                        @if (m.ModeloMateriales != null && m.ModeloMateriales.Any())
                        {
                            <ul>
                                @foreach (var mm in m.ModeloMateriales)
                                {
                                    <li>
                                        @mm.Material.Nombre - @mm.Material.Color
                                        (@mm.Cantidad @mm.Material.UnidadMedida)
                                    </li>
                                }
                            </ul>
                        }
                        else
                        {
                            <p style="font-size:12px;color:var(--texto-suave);margin:0">Sin materiales registrados aún.</p>
                        }
                    </div>

                    <!-- Stepper de cantidad: + caja − -->
                    <div class="cantidad-control">
                        <button type="button" class="qty-icon-btn agregar" title="Agregar al carrito"
                                onclick="agregarAlCarrito(@m.IdModelo, '@m.Nombre', document.getElementById('cantidad-@m.IdModelo').value)">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19" /><line x1="5" y1="12" x2="19" y2="12" /></svg>
                        </button>

                        <input type="number" id="cantidad-@m.IdModelo" value="1" min="1" class="cantidad-input" />

                        <button type="button" class="qty-icon-btn quitar" title="Quitar del carrito"
                                onclick="quitarUnoDelCarrito(@m.IdModelo)">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="5" y1="12" x2="19" y2="12" /></svg>
                        </button>
                    </div>
                    <span id="carrito-cantidad-@m.IdModelo" class="en-carrito">En carrito: <strong>0</strong></span>
                </div>
            </div>
        }
    </div>

    <!-- ===== CARRITO LATERAL ===== -->
    <aside class="catalogo-carrito carrito-oculto" id="barra-carrito">
        <div class="carrito-header">
            <span class="carrito-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="9" cy="21" r="1" />
                    <circle cx="20" cy="21" r="1" />
                    <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6" />
                </svg>
            </span>
            <span class="carrito-titulo">Carrito</span>
            <span class="carrito-total-badge" id="carrito-total-badge">0</span>
        </div>

        <div class="carrito-lista" id="resumen-carrito"></div>

        <span class="carrito-error" id="error-carrito"></span>

        <button type="button" onclick="enviarCarrito()" class="btn-pastel carrito-btn" id="btn-registrar-pedido">
            Registrar pedido
        </button>
    </aside>
</div>

<script>
    // Carrito en memoria: { idModelo: { nombre, cantidad } }
    const carrito = {};

    function totalItemsCarrito() {
        return Object.values(carrito).reduce((acc, item) => acc + item.cantidad, 0);
    }

    function agregarAlCarrito(idModelo, nombre, cantidad) {
        cantidad = parseInt(cantidad, 10);
        if (isNaN(cantidad) || cantidad < 1) cantidad = 1;

        if (carrito[idModelo]) {
            carrito[idModelo].cantidad += cantidad;
        } else {
            carrito[idModelo] = { nombre: nombre, cantidad: cantidad };
        }

        document.getElementById('carrito-cantidad-' + idModelo).innerHTML =
            'En carrito: <strong>' + carrito[idModelo].cantidad + '</strong>';

        actualizarBarraCarrito();
    }

    // Resta del carrito la cantidad que esté en el input de esa card (mismo valor que usa el botón +).
    // Si llega a 0 o menos, el modelo se quita por completo del carrito.
    function quitarUnoDelCarrito(idModelo) {
        if (!carrito[idModelo]) return;

        let cantidad = parseInt(document.getElementById('cantidad-' + idModelo).value, 10);
        if (isNaN(cantidad) || cantidad < 1) cantidad = 1;

        carrito[idModelo].cantidad -= cantidad;

        if (carrito[idModelo].cantidad <= 0) {
            quitarDelCarrito(idModelo);
            return;
        }

        document.getElementById('carrito-cantidad-' + idModelo).innerHTML =
            'En carrito: <strong>' + carrito[idModelo].cantidad + '</strong>';

        actualizarBarraCarrito();
    }

    function quitarDelCarrito(idModelo) {
        delete carrito[idModelo];
        const span = document.getElementById('carrito-cantidad-' + idModelo);
        if (span) span.innerHTML = 'En carrito: <strong>0</strong>';
        actualizarBarraCarrito();
    }

    function actualizarBarraCarrito() {
        const ids = Object.keys(carrito);
        const barra = document.getElementById('barra-carrito');
        const resumen = document.getElementById('resumen-carrito');
        const badge = document.getElementById('carrito-total-badge');

        badge.textContent = totalItemsCarrito();

        // Se oculta/muestra con una clase (display:none). Ya no rompe el
        // "sticky" al reaparecer porque esa causa real (overflow-x:hidden
        // puesto en <body>) ya está corregida.
        if (ids.length === 0) {
            barra.classList.add('carrito-oculto');
            resumen.innerHTML = '';
            return;
        }

        barra.classList.remove('carrito-oculto');

        resumen.innerHTML = ids.map(id => `
                <div class="carrito-item">
                    <span class="nombre">${carrito[id].nombre}</span>
                    <span class="cantidad">x${carrito[id].cantidad}</span>
                    <button type="button" class="quitar-item" onclick="quitarDelCarrito(${id})" title="Quitar">✕</button>
                </div>
            `).join('');
    }

    async function enviarCarrito() {
        const errorSpan = document.getElementById('error-carrito');
        errorSpan.textContent = '';

        const seleccion = Object.keys(carrito).map(id => ({
            idModelo: parseInt(id, 10),
            cantidad: carrito[id].cantidad
        }));

        if (seleccion.length === 0) return;

        const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

        try {
            const respuesta = await fetch('/Pedido/RecibirSeleccion', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token
                },
                body: JSON.stringify(seleccion)
            });

            if (!respuesta.ok) {
                const texto = await respuesta.text();
                errorSpan.textContent = texto || 'No se pudo enviar el pedido.';
                return;
            }

            const data = await respuesta.json();
            window.location.href = data.redirectUrl;
        } catch (e) {
            errorSpan.textContent = 'Error de conexión, intenta de nuevo.';
        }
    }
</script>
