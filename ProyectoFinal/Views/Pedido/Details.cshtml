@model Pedido

@{
    ViewData["Title"] = "Detalle del pedido";
    string estadoClase = Model.Estado.ToString().ToLowerInvariant();
}

<div class="detalle-header">
    <h1>Pedido #@Model.IdPedido</h1>
    <div class="detalle-acciones">
        <a class="btn-pastel" asp-action="Edit" asp-route-id="@Model.IdPedido">✏️ Editar</a>
        <a class="btn-secundario" asp-action="Index">← Volver</a>
    </div>
</div>

<div class="detalle-box">
    <div class="detalle-grid">
        <div class="detalle-item">
            <span class="etiqueta">Cliente</span>
            <span class="valor">@Model.Cliente</span>
        </div>
        <div class="detalle-item">
            <span class="etiqueta">Estado</span>
            <span class="valor"><span class="badge-estado-pedido estado-@estadoClase">@Model.Estado</span></span>
        </div>
        <div class="detalle-item">
            <span class="etiqueta">Fecha de pedido</span>
            <span class="valor">@Model.FechaPedido.ToString("dd/MM/yyyy HH:mm")</span>
        </div>
        <div class="detalle-item">
            <span class="etiqueta">Fecha de inicio</span>
            <span class="valor">@Model.FechaInicio.ToString("dd/MM/yyyy HH:mm")</span>
        </div>
        <div class="detalle-item">
            <span class="etiqueta">Fecha de entrega</span>
            <span class="valor">@Model.FechaEntrega.ToString("dddd dd/MM/yyyy HH:mm")</span>
        </div>
        <div class="detalle-item">
            <span class="etiqueta">Horas de producción</span>
            <span class="valor">@Model.HorasProduccionTotal horas</span>
        </div>
    </div>
</div>

<div class="detalle-box">
    <h4 class="detalle-seccion-titulo">Modelos pedidos</h4>
    <div class="tabla-responsive">
        <table class="tabla-pastel">
            <thead>
                <tr>
                    <th>Modelo</th>
                    <th>Cantidad</th>
                    <th>Precio unitario</th>
                    <th>Subtotal</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var detalle in Model.Detalles)
                {
                    <tr>
                        <td>@detalle.Modelo.Nombre</td>
                        <td>@detalle.Cantidad</td>
                        <td>@detalle.Modelo.PrecioVenta.ToString("Bs. ")</td>
                        <td>@((detalle.Modelo.PrecioVenta * detalle.Cantidad).ToString("Bs. "))</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <th colspan="3" style="text-align:right">Total</th>
                    <th>@Model.PrecioVentaTotal.ToString("Bs. ")</th>
                </tr>
            </tfoot>
        </table>
    </div>
</div>
