@model ProyectoFinal.Dto.ReporteDto

@{
    ViewData["Title"] = "Reportes";
}

<div class="page-header">
    <h1 class="page-title">Reportes</h1>
    <p class="page-eyebrow">Selecciona un rango de fechas para ver el resumen financiero</p>
</div>

<form asp-controller="Reporte" asp-action="Index" method="get" class="reporte-filtro-box">
    <div class="campo-fecha">
        <label>Desde</label>
        <input type="date" name="desde" value="@ViewBag.Desde" required />
    </div>
    <div class="campo-fecha">
        <label>Hasta</label>
        <input type="date" name="hasta" value="@ViewBag.Hasta" required />
    </div>
    <button type="submit" class="btn-pastel">
        Ver reporte
    </button>
</form>

<!-- ===== RESUMEN FINANCIERO ===== -->
<div class="finance-summary">
    <div class="finance-card finance-ingresos">
        <span class="finance-label">Dinero ingresado</span>
        <span class="finance-value">@Model.IngresosTotales.ToString("C")</span>
        <span class="finance-hint">Ventas del periodo</span>
    </div>

    <div class="finance-operator">−</div>

    <div class="finance-card finance-gastos">
        <span class="finance-label">Gasto en materiales</span>
        <span class="finance-value">@Model.GastoMateriales.ToString("C")</span>
        <span class="finance-hint">Costo de producción</span>
    </div>

    <div class="finance-operator">=</div>

    <div class="finance-card finance-ganancia">
        <span class="finance-label">Ganancia neta</span>
        <span class="finance-value">@Model.UtilidadTotal.ToString("C")</span>
        <span class="finance-hint">Margen: @Model.MargenUtilidad.ToString("0.0")%</span>
    </div>
</div>

@if (Model.VariacionUtilidadPorcentaje != 0)
{
    <div class="mb-4">
        @if (Model.VariacionUtilidadPorcentaje > 0)
        {
            <span class="badge-trend badge-trend-up">▲ @Model.VariacionUtilidadPorcentaje.ToString("0.0")% vs. periodo anterior</span>
        }
        else
        {
            <span class="badge-trend badge-trend-down">▼ @Math.Abs(Model.VariacionUtilidadPorcentaje).ToString("0.0")% vs. periodo anterior</span>
        }
    </div>
}

<!-- ===== DATOS COMPLEMENTARIOS ===== -->
<div class="metric-grid">
    <div class="card-modelo metric-card">
        <p class="metric-label">Pedidos realizados</p>
        <p class="metric-value">@Model.PedidosRealizados</p>
    </div>
    <div class="card-modelo metric-card">
        <p class="metric-label">Ticket promedio</p>
        <p class="metric-value">@Model.TicketPromedio.ToString("C")</p>
    </div>
    <div class="card-modelo metric-card">
        <p class="metric-label">Horas trabajadas</p>
        <p class="metric-value">@Model.HorasTrabajadas</p>
    </div>
    <div class="card-modelo metric-card">
        <p class="metric-label">Ganancia por hora</p>
        <p class="metric-value">@Model.UtilidadPorHora.ToString("C")</p>
    </div>
</div>

<div class="reporte-destacado">
    <div class="card-modelo">
        <p class="metric-label">Modelo más vendido</p>
        <h5>@Model.ModeloMasVendido</h5>
        <span class="section-empty">@Model.CantidadMasVendido unidades</span>
    </div>
    <div class="card-modelo">
        <p class="metric-label">Modelo más rentable</p>
        <h5>@Model.ModeloMasRentable</h5>
        <span class="section-empty">@Model.UtilidadModeloMasRentable.ToString("C") de ganancia</span>
    </div>
</div>

@{
    var normales = Model.Pedidos.Where(p => p.Tipo == "Normal").ToList();
    var personalizados = Model.Pedidos.Where(p => p.Tipo == "Personalizado").ToList();
}

<!-- ===== PEDIDOS NORMALES ===== -->
<div class="reporte-seccion">
    <h4>Pedidos</h4>
    @if (!normales.Any())
    {
        <p class="section-empty">No hay pedidos en este periodo.</p>
    }
    else
    {
        <table class="tabla-pastel">
            <thead>
                <tr>
                    <th>N.° Pedido</th>
                    <th>Cliente</th>
                    <th>Fecha pedido</th>
                    <th>Fecha entrega</th>
                    <th>Estado</th>
                    <th>Horas</th>
                    <th>Total</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in normales)
                {
                    string estadoClase = p.Estado.ToString().ToLowerInvariant();
                    <tr>
                        <td style="font-weight:600;">P@(p.IdPedido.ToString("D4"))</td>
                        <td>@p.Cliente</td>
                        <td>@p.FechaPedido.ToString("dd/MM/yyyy")</td>
                        <td>@p.FechaEntrega.ToString("dd/MM/yyyy")</td>
                        <td><span class="badge-estado-pedido estado-@estadoClase">@p.Estado</span></td>
                        <td>@p.Horas</td>
                        <td>@p.Total.ToString("C")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

<!-- ===== PEDIDOS PERSONALIZADOS ===== -->
<div class="reporte-seccion">
    <h4>Pedidos personalizados</h4>
    @if (!personalizados.Any())
    {
        <p class="section-empty">No hay pedidos personalizados en este periodo.</p>
    }
    else
    {
        <table class="tabla-pastel">
            <thead>
                <tr>
                    <th>N.° Pedido</th>
                    <th>Cliente</th>
                    <th>Fecha pedido</th>
                    <th>Fecha entrega</th>
                    <th>Estado</th>
                    <th>Horas</th>
                    <th>Total</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in personalizados)
                {
                    string estadoClase = p.Estado.ToString().ToLowerInvariant();
                    <tr>
                        <td style="font-weight:600;">P@(p.IdPedido.ToString("D4"))</td>
                        <td>@p.Cliente</td>
                        <td>@p.FechaPedido.ToString("dd/MM/yyyy")</td>
                        <td>@p.FechaEntrega.ToString("dd/MM/yyyy")</td>
                        <td><span class="badge-estado-pedido estado-@estadoClase">@p.Estado</span></td>
                        <td>@p.Horas</td>
                        <td>@p.Total.ToString("C")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

<!-- ===== BOTÓN DE EXPORTAR ===== -->
<form asp-controller="Reporte" asp-action="ExportarExcel" method="post" class="mt-4">
    <input type="hidden" name="desde" value="@ViewBag.Desde" />
    <input type="hidden" name="hasta" value="@ViewBag.Hasta" />
    <button type="submit" class="btn-exportar">
        Descargar en Excel
    </button>
</form>
