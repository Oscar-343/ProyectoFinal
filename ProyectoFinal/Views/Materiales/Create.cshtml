@model ProyectoFinal.Models.material

<h1>Registrar Material</h1>
<p>
    Complete los datos del material que desea registrar.
</p>

<form asp-action="Create">
    <div class="mb-3">
        <label>Nombre del material</label>
        <input asp-for="Nombre" class="form-control" placeholder="Ejemplo: Lana acrílica" />
        <span asp-validation-for="Nombre" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label>Tipo de material</label>
        <input asp-for="Tipo" class="form-control" placeholder="Ejemplo: Hilo" />
        <span asp-validation-for="Tipo" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label>Color</label>
        <input asp-for="Color" class="form-control" placeholder="Ejemplo: Rosado" />
        <span asp-validation-for="Color" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label>Unidad de medida</label>
        <input asp-for="UnidadMedida" class="form-control" placeholder="Ejemplo: Ovillo" />
        <span asp-validation-for="UnidadMedida" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label>Cantidad disponible</label>
        <input asp-for="CantidadDisponible" type="number" step="0.01" class="form-control" placeholder="Ejemplo: 10" />
        <small>Ingrese la cantidad disponible actualmente.</small>
    </div>

    <div class="mb-3">
        <label>Precio por unidad (Bs.)</label>
        <input asp-for="PrecioUnitario" type="number" step="0.01" class="form-control" placeholder="Ejemplo: 18.00" />
        <small>Ingrese el precio de una unidad del material.</small>
    </div>

    <div class="mb-3">
        <label>Stock mínimo</label>
        <input asp-for="StockMinimo" type="number" step="0.01" class="form-control" placeholder="Ejemplo: 5" />
        <small>Cantidad mínima que desea mantener disponible.</small>
    </div>

    <button type="submit" class="btn btn-success">Guardar material</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>