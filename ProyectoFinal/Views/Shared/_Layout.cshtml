<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Amigurumis Luna</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ProyectoFinal.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/amigurumis.css" asp-append-version="true" />
</head>
<body>
    <div class="app-shell">

        <!-- ===== SIDEBAR ===== -->
        <aside class="sidebar">
            <div class="sidebar-brand">
                <span class="brand-mark">◆</span>
                <div class="brand-text">
                    <span class="brand-title">AMIGURUMIS</span>
                    <span class="brand-subtitle">LUNA</span>
                </div>
            </div>

            <div class="sidebar-session">
                <span class="session-dot"></span>
                Sesión activa: <strong>@ViewBag.NombreUsuario</strong>
            </div>

            <nav class="sidebar-nav">
                <a class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")"
                   asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="nav-bracket"></span>Inicio<span class="nav-bracket"></span>
                </a>

                <a class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Modelo" ? "active" : "")"
                   asp-area="" asp-controller="Modelo" asp-action="Index">
                    <span class="nav-bracket"></span>Modelos<span class="nav-bracket"></span>
                </a>

                <a class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Materiales" ? "active" : "")"
                   asp-area="" asp-controller="Materiales" asp-action="Index">
                    <span class="nav-bracket"></span>Materiales<span class="nav-bracket"></span>
                </a>

                <a class="nav-item" asp-area="" asp-controller="Modelo" asp-action="Catalogo">
                    <span class="nav-bracket"></span>Catálogo<span class="nav-bracket"></span>
                </a>

                <!-- Dropdown de Pedidos -->
                <div class="nav-group">
                    <button class="nav-item nav-item-toggle" type="button"
                            data-bs-toggle="collapse" data-bs-target="#pedidosSubmenu"
                            aria-expanded="false" aria-controls="pedidosSubmenu">
                        <span class="nav-bracket"></span>Pedidos<span class="nav-bracket"></span>
                        <span class="nav-caret">▾</span>
                    </button>

                    <div class="collapse @(ViewContext.RouteData.Values["controller"]?.ToString() == "Pedido" || ViewContext.RouteData.Values["controller"]?.ToString() == "PedidoPersonalizado" ? "show" : "")" id="pedidosSubmenu">
                        <a class="nav-subitem" asp-controller="Pedido" asp-action="Index">
                            Todos los pedidos
                        </a>
                        <a class="nav-subitem" asp-controller="Pedido" asp-action="Index" asp-route-estado="Pendiente">
                            Pedidos pendientes
                        </a>
                        <a class="nav-subitem" asp-controller="PedidoPersonalizado" asp-action="Index">
                            Pedidos personalizados
                        </a>
                    </div>
                </div>

                <span class="nav-item" style="opacity:.4;cursor:not-allowed">
                    <span class="nav-bracket"></span>Reportes<span class="nav-bracket"></span>
                </span>
            </nav>

            <div class="sidebar-footer">
                <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                <span>&copy; 2026 ProyectoFinal</span>
            </div>
        </aside>

        <!-- ===== CONTENIDO ===== -->
        <div class="main-wrapper">
            <header class="topbar">
                <button class="sidebar-toggle" type="button" id="sidebarToggle" aria-label="Toggle menu">☰</button>
                <span class="topbar-title">@ViewData["Title"]</span>
            </header>

            <main role="main" class="content-area">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
            document.getElementById('sidebarToggle')?.addEventListener('click', function() {
                document.querySelector('.app-shell').classList.toggle('sidebar-collapsed');
            });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>