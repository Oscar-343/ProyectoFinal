@model ProyectoFinal.ViewModels.HomeDashboardViewModel
@{
    ViewData["Title"] = "Inicio";
}

<h2 class="titulo">Amigurumis Luna — panel de administración</h2>
<p class="dashboard-subtitle">Sesión activa: @ViewBag.NombreUsuario</p>

<!-- Métricas generales -->
<div class="metric-grid">
    <div class="card-modelo metric-card">
        <p class="metric-label">Modelos registrados</p>
        <p class="metric-value">@Model.TotalModelos</p>
    </div>
    <div class="card-modelo metric-card">
        <p class="metric-label">Materiales registrados</p>
        <p class="metric-value">@Model.TotalMateriales</p>
    </div>
    <div class="card-modelo metric-card">
        <p class="metric-label">Materiales por acabarse</p>
        <p class="metric-value alerta">@Model.MaterialesPorAcabarse.Count</p>
    </div>
</div>

<!-- Materiales por acabarse -->
<div class="card-modelo section-card">
    <h5 class="titulo">Materiales por acabarse</h5>

    @if (Model.MaterialesPorAcabarse.Any())
    {
        <table class="tabla-pastel">
            <thead>
                <tr>
                    <th>Material</th>
                    <th>Disponible</th>
                    <th>Stock mínimo</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var mat in Model.MaterialesPorAcabarse)
                {
                    <tr>
                        <td>@mat.Nombre</td>
                        <td style="color:#C62828">@mat.CantidadDisponible @mat.UnidadMedida</td>
                        <td>@mat.StockMinimo @mat.UnidadMedida</td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p class="section-empty">Ningún material está por debajo de su stock mínimo.</p>
    }
</div>
