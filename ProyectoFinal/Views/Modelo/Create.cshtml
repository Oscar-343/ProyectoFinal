@model ProyectoFinal.Models.Modelo

<link rel="stylesheet" href="~/css/amigurumis.css" />

<h2 class="titulo">Registrar modelo</h2>

<form asp-action="Create" method="post" style="max-width:480px">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-2">
        <label asp-for="Nombre"></label>
        <input asp-for="Nombre" class="form-control" />
        <span asp-validation-for="Nombre" class="text-danger"></span>
    </div>

    <div class="mb-2">
        <label asp-for="Descripcion"></label>
        <textarea asp-for="Descripcion" class="form-control"></textarea>
        <span asp-validation-for="Descripcion" class="text-danger"></span>
    </div>

    <div class="mb-2">
        <label asp-for="Imagen">URL de imagen</label>
        <input asp-for="Imagen" class="form-control" placeholder="https://..." />
        <span asp-validation-for="Imagen" class="text-danger"></span>
    </div>

    <div class="mb-2">
        <label asp-for="Dificultad"></label>
        <select asp-for="Dificultad" class="form-control">
            <option value="">-- Seleccione --</option>
            <option value="Baja">Baja</option>
            <option value="Media">Media</option>
            <option value="Alta">Alta</option>
        </select>
        <span asp-validation-for="Dificultad" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="TiempoProduccion">Tiempo de producción (horas)</label>
        <input asp-for="TiempoProduccion" type="number" step="0.5" class="form-control" />
        <span asp-validation-for="TiempoProduccion" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label>Materiales usados</label>

        <div id="filas-materiales"></div>

        <button type="button" id="btn-agregar-material" class="btn-secundario" style="margin-top:6px">
            + Agregar material
        </button>

        <p style="color:#777; font-size:13px; margin-top:6px">
            El costo y precio de venta se calculan automáticamente según los materiales y cantidades elegidos.
        </p>
    </div>

    <button type="submit" class="btn-pastel">Guardar</button>
</form>

<template id="plantilla-fila-material">
    <div class="d-flex gap-2 mb-1 fila-material" style="display:flex;gap:8px;margin-bottom:6px">
        <select name="materialesSeleccionados" class="form-control">
            @foreach (var mat in (List<ProyectoFinal.Models.material>)ViewBag.Materiales)
            {
                <option value="@mat.IdMaterial">@mat.Nombre (Bs. @mat.PrecioUnitario / @mat.UnidadMedida)</option>
            }
        </select>
        <input type="number" name="cantidades" step="0.01" min="0.01" placeholder="Cantidad" class="form-control" style="max-width:120px" required />
        <button type="button" class="btn-secundario btn-quitar-material">Quitar</button>
    </div>
</template>

<script>
    document.getElementById('btn-agregar-material').addEventListener('click', function () {
        var plantilla = document.getElementById('plantilla-fila-material');
        var clon = plantilla.content.cloneNode(true);

        clon.querySelector('.btn-quitar-material').addEventListener('click', function (e) {
            e.target.closest('.fila-material').remove();
        });

        document.getElementById('filas-materiales').appendChild(clon);
    });

    // Agrega una primera fila automáticamente al cargar la página.
    document.getElementById('btn-agregar-material').click();
</script>
