@model ProyectoFinal.Models.material

<h2 class="titulo">Eliminar material</h2>
<p style="color:#777;font-size:14px">Está a punto de eliminar el siguiente material:</p>

<div class="alerta-pastel">
    <strong>Advertencia:</strong> esta acción eliminará el material de la base de datos.
</div>

<table class="tabla-pastel" style="max-width:420px">
    <tr>
        <th>Nombre</th>
        <td>@Model.Nombre</td>
    </tr>
    <tr>
        <th>Tipo</th>
        <td>@Model.Tipo</td>
    </tr>
    <tr>
        <th>Color</th>
        <td>@Model.Color</td>
    </tr>
    <tr>
        <th>Cantidad disponible</th>
        <td>@Model.CantidadDisponible</td>
    </tr>
    <tr>
        <th>Precio</th>
        <td>Bs. @Model.PrecioUnitario</td>
    </tr>
</table>

<p style="margin-top:1rem">¿Está seguro de que desea eliminar este material?</p>

<form asp-action="DeleteConfirmed">
    <input type="hidden" name="id" value="@Model.IdMaterial" />
    <button type="submit" class="btn-peligro">Sí, eliminar</button>
    <a asp-action="Index" class="btn-secundario">Cancelar</a>
</form>
