@model ProyectoFinal.Models.Modelo

@{
    ViewData["Title"] = "Registrar modelo";
}

<div class="page-header">
    <h1 class="page-title">Registrar modelo</h1>
    <p class="page-eyebrow">Completa los datos del nuevo diseño de amigurumi</p>
</div>

<div class="form-box form-box-ancho">
    <form asp-action="Create" method="post" class="form-pastel">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="mb-2">
            <label asp-for="Nombre"></label>
            <input asp-for="Nombre" />
            <span asp-validation-for="Nombre" class="text-danger"></span>
        </div>

        <div class="mb-2">
            <label asp-for="Descripcion"></label>
            <textarea asp-for="Descripcion"></textarea>
            <span asp-validation-for="Descripcion" class="text-danger"></span>
        </div>

        <div class="mb-2">
            <label asp-for="Imagen">URL de imagen</label>
            <input asp-for="Imagen" placeholder="https://..." />
            <span asp-validation-for="Imagen" class="text-danger"></span>
        </div>

        <!-- Select de dificultad: el valor elegido aquí (Baja/Media/Alta) viaja al controller
             y ahí se usa para decidir el multiplicador de ganancia. -->
        <div class="mb-2">
            <label asp-for="Dificultad"></label>
            <select asp-for="Dificultad">
                <option value="">-- Seleccione --</option>
                <option value="Baja">Baja</option>
                <option value="Media">Media</option>
                <option value="Alta">Alta</option>
            </select>
            <span asp-validation-for="Dificultad" class="text-danger"></span>
        </div>

        <!-- Horas de trabajo: el controller multiplica este valor x Bs. 5 para sacar la mano de obra. -->
        <div class="mb-3">
            <label asp-for="TiempoProduccion">Tiempo de producción (horas)</label>
            <input asp-for="TiempoProduccion" type="number" step="0.5" />
            <span asp-validation-for="TiempoProduccion" class="text-danger"></span>
            <small>Se usa para calcular la mano de obra (Bs. 5 por hora).</small>
        </div>

        <!-- Aquí el usuario arma la lista de materiales usados: cada fila es un
             material + una cantidad. El JavaScript de abajo permite agregar filas nuevas. -->
        <div class="mb-3">
            <label>Materiales usados</label>

            <div id="filas-materiales"></div>

            <button type="button" id="btn-agregar-material" class="btn-secundario" style="margin-top:6px">
                + Agregar material
            </button>

            <p style="color:var(--texto-suave); font-size:12.5px; margin-top:8px">
                El costo (materiales + mano de obra) y el precio de venta se calculan automáticamente
                según los materiales elegidos, el tiempo de producción y la dificultad seleccionada.
            </p>
        </div>

        <button type="submit" class="btn-pastel">Guardar</button>
    </form>
</div>

<!-- Plantilla HTML invisible: es el "molde" de una fila de material.
     No se muestra sola; se clona con JavaScript cada vez que se agrega una fila. -->
<template id="plantilla-fila-material">
    <div class="fila-material">
        <select name="materialesSeleccionados">
            @foreach (var mat in (List<ProyectoFinal.Models.material>)ViewBag.Materiales)
            {
                <option value="@mat.IdMaterial">@mat.Nombre - @mat.Color (Bs. @mat.PrecioUnitario / @mat.UnidadMedida)</option>
            }
        </select>
        <input type="number" name="cantidades" step="0.01" min="0.01" placeholder="Cantidad" required />
        <button type="button" class="btn-secundario btn-quitar-material">Quitar</button>
    </div>
</template>

<script>
    // Cada vez que se hace clic en "+ Agregar material", se clona la plantilla
    // de arriba y se agrega como una fila nueva dentro de #filas-materiales.
    document.getElementById('btn-agregar-material').addEventListener('click', function() {
        var plantilla = document.getElementById('plantilla-fila-material');
        var clon = plantilla.content.cloneNode(true);

        // Le da funcionalidad al botón "Quitar" de esa fila específica.
        clon.querySelector('.btn-quitar-material').addEventListener('click', function(e) {
            e.target.closest('.fila-material').remove();
        });

        document.getElementById('filas-materiales').appendChild(clon);
    });

    // Agrega una primera fila automáticamente al cargar la página,
    // para que el formulario no empiece completamente vacío.
    document.getElementById('btn-agregar-material').click();
</script>
