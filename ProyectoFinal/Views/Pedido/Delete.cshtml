@model Pedido

@{
    ViewData["Title"] = "Eliminar pedido";
}

<div class="page-header">
    <h1 class="page-title">Eliminar pedido</h1>
    <p class="page-eyebrow">Esta acción no se puede deshacer</p>
</div>

<div class="detalle-box" style="max-width:560px;margin:0 auto">
    <div class="caja-peligro">
        ⚠️ ¿Seguro que deseas eliminar este pedido? Esta acción no se puede deshacer.
    </div>

    <div class="detalle-grid">
        <div class="detalle-item">
            <span class="etiqueta">Cliente</span>
            <span class="valor">@Model.Cliente</span>
        </div>
        <div class="detalle-item">
            <span class="etiqueta">Estado</span>
            <span class="valor">@Model.Estado</span>
        </div>
        <div class="detalle-item">
            <span class="etiqueta">Fecha de entrega</span>
            <span class="valor">@Model.FechaEntrega.ToString("dd/MM/yyyy HH:mm")</span>
        </div>
        <div class="detalle-item">
            <span class="etiqueta">Modelos</span>
            <span class="valor">@string.Join(", ", Model.Detalles.Select(d => $"{d.Modelo.Nombre} x{d.Cantidad}"))</span>
        </div>
    </div>

    <form asp-action="Delete" asp-route-id="@Model.IdPedido" method="post" style="margin-top:18px">
        <input type="hidden" asp-for="IdPedido" />
        <button type="submit" class="btn-peligro">Sí, eliminar</button>
        <a asp-action="Index" class="btn-secundario">Cancelar</a>
    </form>
</div>
