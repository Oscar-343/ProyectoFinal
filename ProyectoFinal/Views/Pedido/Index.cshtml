@model List<ProyectoFinal.ViewModels.PedidoResumenViewModel>

@{
    ViewData["Title"] = ViewBag.TituloLista;
}

<div class="content-header">
    <h2>@ViewBag.TituloLista</h2>
    <a class="btn btn-primary" asp-controller="Pedido" asp-action="Create">+ Nuevo pedido</a>
</div>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">@TempData["Mensaje"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@if (!Model.Any())
{
    <p>No hay pedidos para mostrar.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Tipo</th>
                <th>Cliente</th>
                <th>Descripción</th>
                <th>Fecha de inicio</th>
                <th>Fecha de entrega</th>
                @if (ViewBag.MostrarTiempoRestante == true)
                {
                    <th>Tiempo restante</th>
                }
                <th>Estado</th>
                <th>Total</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var pedido in Model)
            {
                string estadoClase = pedido.Estado.ToString().ToLowerInvariant();
                string tiempoRestante = ViewBag.MostrarTiempoRestante == true
                    ? CalcularTiempoRestante(pedido.FechaEntrega)
                    : null;

                <tr>
                    <td>
                        @if (pedido.Tipo == "Personalizado")
                        {
                            <span class="badge bg-info">Personalizado</span>
                        }
                        else
                        {
                            <span>Normal</span>
                        }
                    </td>
                    <td>@pedido.Cliente</td>
                    <td>@pedido.Descripcion</td>
                    <td>@pedido.FechaInicio.ToString("dd/MM/yyyy")</td>
                    <td>@pedido.FechaEntrega.ToString("dd/MM/yyyy")</td>
                    @if (ViewBag.MostrarTiempoRestante == true)
                    {
                        <td>@tiempoRestante</td>
                    }
                    <td>
                        <span class="badge estado-@estadoClase">@pedido.Estado</span>
                    </td>
                    <td>@pedido.Total.ToString("C")</td>
                    <td>
                        @if (pedido.Tipo == "Normal")
                        {
                            <a asp-controller="Pedido" asp-action="Details" asp-route-id="@pedido.Id">Ver</a>
                            <a asp-controller = "Pedido" asp-action = "Edit" asp-route-id = "@pedido.Id" > Editar </a >
                            <a asp-controller = "Pedido" asp-action = "Delete" asp-route-id = "@pedido.Id" > Eliminar </a >
}
                        else
                        {
                            <a asp-controller="PedidoPersonalizado" asp-action="Details" asp-route-id="@pedido.Id">Ver</a>
                            <a asp-controller = "PedidoPersonalizado" asp-action = "Edit" asp-route-id = "@pedido.Id" > Editar </a >
                            <a asp-controller = "PedidoPersonalizado" asp-action = "Delete" asp-route-id = "@pedido.Id" > Eliminar </a >
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@functions {
    string CalcularTiempoRestante(DateTime fechaEntrega)
    {
        var restante = fechaEntrega - DateTime.Now;
        if (restante.TotalHours <= 0) return "Vencido";
        int dias = restante.Days;
        int horas = restante.Hours;
        return dias == 0 ? $"{horas} horas" : $"{dias} días, {horas} horas";
    }
}