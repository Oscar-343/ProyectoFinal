@model IEnumerable<ProyectoFinal.Models.material>

<link rel="stylesheet" href="~/css/amigurumis.css" />

<h2 class="titulo">Gestión de materiales</h2>
<p style="color:#777;font-size:14px">
    Aquí puede consultar y administrar los materiales utilizados para fabricar los amigurumis.
</p>

<a asp-action="Create" class="btn-pastel" style="text-decoration:none;display:inline-block">
    + Registrar nuevo material
</a>
<br />
<br />

<table class="tabla-pastel">
    <thead>
        <tr>
            <th>Material</th>
            <th>Tipo</th>
            <th>Color</th>
            <th>Unidad</th>
            <th>Cantidad</th>
            <th>Precio</th>
            <th>Stock mínimo</th>
            <th>Estado</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Nombre</td>
                <td>@item.Tipo</td>
                <td>@item.Color</td>
                <td>@item.UnidadMedida</td>
                <td>@item.CantidadDisponible</td>
                <td>Bs. @item.PrecioUnitario</td>
                <td>@item.StockMinimo</td>
                <td>
                    @if (item.Estado == "stock agotado")
                    {
                        <span class="badge-estado agotado">Sin stock</span>
                    }
                    else if (item.Estado == "stock bajo")
                    {
                        <span class="badge-estado bajo">Stock bajo</span>
                    }
                    else
                    {
                        <span class="badge-estado disponible">Disponible</span>
                    }
                </td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.IdMaterial">Ver</a>
                    |
                    <a asp-action="Edit" asp-route-id="@item.IdMaterial">Editar</a>
                    |
                    <a asp-action="Delete" asp-route-id="@item.IdMaterial">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>
