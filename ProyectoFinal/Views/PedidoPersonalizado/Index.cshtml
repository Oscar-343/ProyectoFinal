@model List<PedidoPersonalizado>

@{
    ViewData["Title"] = "Pedidos personalizados";
}

<div class="page-header">
    <h1 class="page-title">Pedidos personalizados</h1>
    <p class="page-eyebrow">Encargos hechos a medida para tus clientes</p>
</div>

<div class="d-flex justify-content-end mb-3">
    <a class="btn-pastel" style="text-decoration:none;display:inline-block;" asp-action="Create">
        + Nuevo pedido personalizado
    </a>
</div>

@if (TempData["Mensaje"] != null)
{
    <div class="alerta-exito">@TempData["Mensaje"]</div>
}

@if (!Model.Any())
{
    <p class="section-empty">No hay pedidos personalizados para mostrar.</p>
}
else
{
    <div class="tabla-responsive">
        <table class="tabla-pastel">
            <thead>
                <tr>
                    <th>Cliente</th>
                    <th>Referencia</th>
                    <th>Dificultad</th>
                    <th>Fecha de entrega</th>
                    <th>Estado</th>
                    <th>Precio</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var pedido in Model)
                {
                    string estadoClase = pedido.Estado.ToString().ToLowerInvariant();

                    <tr>
                        <td style="font-weight:600;">@pedido.Cliente</td>
                        <td>@pedido.NombreReferencia</td>
                        <td>@pedido.Dificultad</td>
                        <td>@pedido.FechaEntrega.ToString("dd/MM/yyyy")</td>
                        <td>
                            <span class="badge-estado-pedido estado-@estadoClase">@pedido.Estado</span>
                        </td>
                        <td>@pedido.PrecioVenta.ToString("Bs. ")</td>
                        <td>
                            <div class="icon-actions">
                                <a asp-action="Details" asp-route-id="@pedido.IdPedidoPersonalizado" class="icon-btn ver" title="Ver">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8Z" />
                                        <circle cx="12" cy="12" r="3" />
                                    </svg>
                                </a>
                                <a asp-action="Edit" asp-route-id="@pedido.IdPedidoPersonalizado" class="icon-btn editar" title="Editar">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M12 20h9" />
                                        <path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z" />
                                    </svg>
                                </a>
                                <a asp-action="Delete" asp-route-id="@pedido.IdPedidoPersonalizado" class="icon-btn eliminar" title="Eliminar">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <polyline points="3 6 5 6 21 6" />
                                        <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" />
                                    </svg>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
