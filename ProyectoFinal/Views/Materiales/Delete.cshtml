@model ProyectoFinal.Models.material

<div class="page-header">
    <h1 class="page-title">Eliminar material</h1>
    <p class="page-eyebrow">Está a punto de eliminar el siguiente material</p>
</div>

<div class="detalle-box" style="max-width:480px;margin:0 auto">
    <div class="caja-peligro">
        ⚠️ <strong>Advertencia:</strong> esta acción eliminará el material de la base de datos.
    </div>

    <div class="tabla-responsive">
        <table class="tabla-pastel">
            <tr>
                <th>Nombre</th>
                <td>@Model.Nombre</td>
            </tr>
            <tr>
                <th>Tipo</th>
                <td>@Model.Tipo</td>
            </tr>
            <tr>
                <th>Color</th>
                <td>@Model.Color</td>
            </tr>
            <tr>
                <th>Cantidad disponible</th>
                <td>@Model.CantidadDisponible</td>
            </tr>
            <tr>
                <th>Precio</th>
                <td>Bs. @Model.PrecioUnitario</td>
            </tr>
        </table>
    </div>

    <form asp-action="DeleteConfirmed" style="margin-top:1rem">
        <input type="hidden" name="id" value="@Model.IdMaterial" />
        <button type="submit" class="btn-peligro">Sí, eliminar</button>
        <a asp-action="Index" class="btn-secundario">Cancelar</a>
    </form>
</div>
