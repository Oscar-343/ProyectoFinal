@model ProyectoFinal.ViewModels.PedidoCreateViewModel

<div class="page-header">
    <h1 class="page-title">Registrar pedido</h1>
    <p class="page-eyebrow">Confirma los modelos elegidos en el catálogo</p>
</div>

<div asp-validation-summary="All" class="alerta-error" style="display:@(ViewData.ModelState.IsValid ? "none" : "block")"></div>

@if (TempData["Error"] != null)
{
    <div class="alerta-error">@TempData["Error"]</div>
}

<div class="pedido-create-layout">

    <div class="form-box">
        <h3 style="font-size:15px;margin:0 0 12px;color:var(--lila-deep)">Modelos seleccionados</h3>

        <div class="tabla-responsive">
            <table class="tabla-pastel">
                <thead>
                    <tr>
                        <th>Modelo</th>
                        <th>Cant.</th>
                        <th>Tiempo (h)</th>
                        <th>Precio</th>
                        <th>Subtotal</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in Model.Detalles)
                    {
                        <tr>
                            <td style="font-weight:600">@d.Nombre</td>
                            <td>@d.Cantidad</td>
                            <td>@d.TiempoProduccion</td>
                            <td>Bs @d.PrecioVenta</td>
                            <td>Bs @d.Subtotal</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div style="margin-top:14px;font-size:13.5px;color:var(--texto)">
            <p style="margin:4px 0"><strong>Horas de producción totales:</strong> @Model.HorasProduccionTotal h</p>
            <p style="margin:4px 0"><strong>Precio de venta total:</strong> Bs @Model.PrecioVentaTotal</p>
        </div>

        <a href="/Modelo/Catalogo" style="font-size:12.5px;color:var(--texto-suave);display:inline-block;margin-top:8px">
            ← Volver al catálogo para modificar la selección
        </a>
    </div>

    <div class="form-box">
        <form asp-action="Create" asp-controller="Pedido" method="post" class="form-pastel">
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label>Cliente</label>
                <input type="text" name="Cliente" value="@Model.Cliente" required />
            </div>

            <div class="mb-2">
                <label>Fecha de inicio</label>
                <input type="datetime-local" name="FechaInicio" value="@Model.FechaInicio.ToString("yyyy-MM-ddTHH:mm")" />
            </div>

            <p style="font-size:12.5px;color:var(--texto-suave);margin:0 0 18px">
                La línea de producción está libre desde el
                <strong>@Model.FechaInicioSugerida.ToString("dddd dd/MM/yyyy HH:mm")</strong>.
                Si eliges una fecha anterior, el sistema la ajustará automáticamente a la
                siguiente disponible. Horario de trabajo: 8:00 a 20:00, de lunes a sábado.
            </p>

            <button type="submit" class="btn-pastel">Confirmar pedido</button>
        </form>
    </div>
</div>
