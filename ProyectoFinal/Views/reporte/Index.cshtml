@model ProyectoFinal.Dto.ReporteDto

@{
    ViewData["Title"] = "Reportes";
}

<h2>Reportes</h2>
<p class="text-muted">Selecciona un rango de fechas para ver el resumen financiero.</p>

<form asp-controller="Reporte" asp-action="Index" method="get" class="row g-3 mb-4 align-items-end">
    <div class="col-auto">
        <label class="form-label">Desde</label>
        <input type="date" name="desde" value="@ViewBag.Desde" class="form-control" required />
    </div>
    <div class="col-auto">
        <label class="form-label">Hasta</label>
        <input type="date" name="hasta" value="@ViewBag.Hasta" class="form-control" required />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-primary">🔍 Ver reporte</button>
    </div>
</form>

<!-- ===== RESUMEN FINANCIERO ===== -->
<div class="finance-summary mb-4">
    <div class="finance-card finance-ingresos">
        <span class="finance-label">Dinero ingresado</span>
        <span class="finance-value">@Model.IngresosTotales.ToString("C")</span>
        <span class="finance-hint">Ventas del periodo</span>
    </div>

    <div class="finance-operator">−</div>

    <div class="finance-card finance-gastos">
        <span class="finance-label">Gasto en materiales</span>
        <span class="finance-value">@Model.GastoMateriales.ToString("C")</span>
        <span class="finance-hint">Costo de producción</span>
    </div>

    <div class="finance-operator">=</div>

    <div class="finance-card finance-ganancia">
        <span class="finance-label">Ganancia neta</span>
        <span class="finance-value">@Model.UtilidadTotal.ToString("C")</span>
        <span class="finance-hint">Margen: @Model.MargenUtilidad.ToString("0.0")%</span>
    </div>
</div>

@if (Model.VariacionUtilidadPorcentaje != 0)
{
    <div class="mb-4">
        @if (Model.VariacionUtilidadPorcentaje > 0)
        {
            <span class="badge-trend badge-trend-up">▲ @Model.VariacionUtilidadPorcentaje.ToString("0.0")% vs. periodo anterior</span>
        }
        else
        {
            <span class="badge-trend badge-trend-down">▼ @Math.Abs(Model.VariacionUtilidadPorcentaje).ToString("0.0")% vs. periodo anterior</span>
        }
    </div>
}

<!-- ===== DATOS COMPLEMENTARIOS ===== -->
<div class="row g-3">
    <div class="col-md-3">
        <div class="card p-3 h-100">
            <span class="text-uppercase text-muted small">Pedidos realizados</span>
            <h4 class="mt-2 mb-0">@Model.PedidosRealizados</h4>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card p-3 h-100">
            <span class="text-uppercase text-muted small">Ticket promedio</span>
            <h4 class="mt-2 mb-0">@Model.TicketPromedio.ToString("C")</h4>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card p-3 h-100">
            <span class="text-uppercase text-muted small">Horas trabajadas</span>
            <h4 class="mt-2 mb-0">@Model.HorasTrabajadas</h4>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card p-3 h-100">
            <span class="text-uppercase text-muted small">Ganancia por hora</span>
            <h4 class="mt-2 mb-0">@Model.UtilidadPorHora.ToString("C")</h4>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card p-3 h-100">
            <span class="text-uppercase text-muted small">Modelo más vendido</span>
            <h5 class="mt-2 mb-0">@Model.ModeloMasVendido</h5>
            <span class="text-muted">@Model.CantidadMasVendido unidades</span>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card p-3 h-100">
            <span class="text-uppercase text-muted small">Modelo más rentable</span>
            <h5 class="mt-2 mb-0">@Model.ModeloMasRentable</h5>
            <span class="text-muted">@Model.UtilidadModeloMasRentable.ToString("C") de ganancia</span>
        </div>
    </div>
</div>

<!-- ===== PEDIDOS NORMALES ===== -->
@{
    var normales = Model.Pedidos.Where(p => p.Tipo == "Normal").ToList();
    var personalizados = Model.Pedidos.Where(p => p.Tipo == "Personalizado").ToList();
}

<div class="mt-5">
    <h4>Pedidos</h4>
    @if (!normales.Any())
    {
        <p class="text-muted">No hay pedidos en este periodo.</p>
    }
    else
    {
        <table class="table table-striped table-bordered">
            <thead class="table-dark">
                <tr>
                    <th>N.° PEDIDO</th>
                    <th>CLIENTE</th>
                    <th>FECHA PEDIDO</th>
                    <th>FECHA ENTREGA</th>
                    <th>ESTADO</th>
                    <th>HORAS</th>
                    <th>TOTAL</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in normales)
                {
                    <tr>
                        <td>P@(p.IdPedido.ToString("D4"))</td>
                        <td>@p.Cliente</td>
                        <td>@p.FechaPedido.ToString("dd/MM/yyyy")</td>
                        <td>@p.FechaEntrega.ToString("dd/MM/yyyy")</td>
                        <td>@p.Estado</td>
                        <td>@p.Horas</td>
                        <td>@p.Total.ToString("C")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

<!-- ===== PEDIDOS PERSONALIZADOS ===== -->
<div class="mt-5">
    <h4>Pedidos Personalizados</h4>
    @if (!personalizados.Any())
    {
        <p class="text-muted">No hay pedidos personalizados en este periodo.</p>
    }
    else
    {
        <table class="table table-striped table-bordered">
            <thead class="table-dark">
                <tr>
                    <th>N.° PEDIDO</th>
                    <th>CLIENTE</th>
                    <th>FECHA PEDIDO</th>
                    <th>FECHA ENTREGA</th>
                    <th>ESTADO</th>
                    <th>HORAS</th>
                    <th>TOTAL</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in personalizados)
                {
                    <tr>
                        <td>P@(p.IdPedido.ToString("D4"))</td>
                        <td>@p.Cliente</td>
                        <td>@p.FechaPedido.ToString("dd/MM/yyyy")</td>
                        <td>@p.FechaEntrega.ToString("dd/MM/yyyy")</td>
                        <td>@p.Estado</td>
                        <td>@p.Horas</td>
                        <td>@p.Total.ToString("C")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

<!-- ===== BOTÓN DE EXPORTAR ===== -->
<form asp-controller="Reporte" asp-action="ExportarExcel" method="post" class="mt-4">
    <input type="hidden" name="desde" value="@ViewBag.Desde" />
    <input type="hidden" name="hasta" value="@ViewBag.Hasta" />
    <button type="submit" class="btn btn-success">
        📊 Descargar en Excel
    </button>
</form>