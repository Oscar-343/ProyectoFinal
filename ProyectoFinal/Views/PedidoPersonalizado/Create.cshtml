@model ProyectoFinal.ViewModels.PedidoPersonalizadoCreateViewModel

<link rel="stylesheet" href="~/css/amigurumis.css" />

<div class="page-header">
    <h2 class="page-title">Pedido personalizado</h2>
</div>

<div class="form-box form-box-ancho">

    <div asp-validation-summary="All" class="alerta-error" style="display:@(ViewData.ModelState.IsValid ? "none" : "block")"></div>

    <form asp-action="Create" asp-controller="PedidoPersonalizado" method="post" enctype="multipart/form-data" class="form-pastel">
        @Html.AntiForgeryToken()

        <div class="mb-3">
            <label>Cliente</label>
            <input type="text" name="Cliente" value="@Model.Cliente" required />
        </div>

        <div class="mb-3">
            <label>Nombre de referencia</label>
            <input type="text" name="NombreReferencia" value="@Model.NombreReferencia"
                   placeholder="Ej: Amigurumi Goku personalizado" required />
        </div>

        <div class="mb-3">
            <label>Descripción (opcional)</label>
            <textarea name="Descripcion" rows="3">@Model.Descripcion</textarea>
        </div>

        <div class="mb-3">
            <label>Imagen de referencia</label>
            <div id="dropzone" class="dropzone-pastel" onclick="document.getElementById('inputImagen').click()">
                <p id="dropzoneTexto">
                    Arrastra una imagen aquí o haz click para seleccionar
                </p>
                <img id="previewImagen" style="display:none;max-width:100%;max-height:200px;margin-top:10px;border-radius:6px" />
            </div>
            <input type="file" id="inputImagen" name="ImagenArchivo" accept=".jpg,.jpeg,.png,.webp"
                   style="display:none" onchange="mostrarPreview(this)" />
            <small>Formatos: jpg, png, webp. Máximo 5MB.</small>
        </div>

        <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px" class="mb-3">
            <div>
                <label>Dificultad</label>
                <select name="Dificultad">
                    <option value="Baja" selected="@(Model.Dificultad == "Baja")">Baja</option>
                    <option value="Media" selected="@(Model.Dificultad == "Media")">Media</option>
                    <option value="Alta" selected="@(Model.Dificultad == "Alta")">Alta</option>
                </select>
            </div>
            <div>
                <label>Tiempo de producción estimado (horas)</label>
                <input type="number" step="0.5" min="0.5" name="TiempoProduccion" value="@Model.TiempoProduccion" required />
            </div>
        </div>

        <div class="mb-3">
            <label>Fecha de inicio</label>
            <input type="datetime-local" name="FechaInicio" value="@Model.FechaInicio.ToString("yyyy-MM-ddTHH:mm")" />
            <small>
                La línea de producción está libre desde el
                <strong>@Model.FechaInicioSugerida.ToString("dddd dd/MM/yyyy HH:mm")</strong>.
                Comparte la misma línea de producción que los pedidos del catálogo normal.
            </small>
        </div>

        <!-- Materiales: mismo patrón de dropdown + cantidad + quitar que usa Modelo/Create -->
        <div class="mb-3">
            <label>Materiales usados</label>

            <div id="filas-materiales" style="margin-top:6px"></div>

            <button type="button" id="btn-agregar-material" class="btn-secundario" style="margin-top:6px">
                + Agregar material
            </button>
        </div>

        <small style="display:block;margin-bottom:16px">
            El costo (materiales + mano de obra) y el precio de venta se calculan automáticamente al guardar,
            con la misma fórmula que usa el catálogo.
        </small>

        <button type="submit" class="btn-agregar">
            Registrar pedido personalizado
        </button>
    </form>
</div>

<!-- Plantilla: el "molde" de una fila de material. Se clona con JS. -->
<template id="plantilla-fila-material">
    <div class="d-flex gap-2 mb-1 fila-material" style="display:flex;gap:8px;margin-bottom:6px">
        <select name="materialesSeleccionados" class="form-control">
            @foreach (var mat in (List<ProyectoFinal.Models.material>)ViewBag.Materiales)
            {
                <option value="@mat.IdMaterial">@mat.Nombre (@mat.Color) - Bs. @mat.PrecioUnitario / @mat.UnidadMedida</option>
            }
        </select>
        <input type="number" name="cantidades" step="0.01" min="0.01" placeholder="Cantidad" class="form-control" style="max-width:120px" required />
        <button type="button" class="btn-secundario btn-quitar-material">Quitar</button>
    </div>
</template>

<script>
    const dropzone = document.getElementById('dropzone');
    const inputImagen = document.getElementById('inputImagen');

    dropzone.addEventListener('dragover', (e) => {
        e.preventDefault();
        dropzone.classList.add('dropzone-activo');
    });
    dropzone.addEventListener('dragleave', () => {
        dropzone.classList.remove('dropzone-activo');
    });
    dropzone.addEventListener('drop', (e) => {
        e.preventDefault();
        dropzone.classList.remove('dropzone-activo');
        if (e.dataTransfer.files.length > 0) {
            inputImagen.files = e.dataTransfer.files;
            mostrarPreview(inputImagen);
        }
    });

    function mostrarPreview(input) {
        const archivo = input.files[0];
        if (!archivo) return;

        const preview = document.getElementById('previewImagen');
        const texto = document.getElementById('dropzoneTexto');
        const lector = new FileReader();
        lector.onload = e => {
            preview.src = e.target.result;
            preview.style.display = 'block';
            texto.textContent = archivo.name;
        };
        lector.readAsDataURL(archivo);
    }

    // Clona la plantilla y, si se le pasan idMaterial/cantidad, prellena la fila
    // (se usa para conservar la selección tras un error de validación).
    function agregarFilaMaterial(idMaterial, cantidad) {
        var plantilla = document.getElementById('plantilla-fila-material');
        var clon = plantilla.content.cloneNode(true);

        var select = clon.querySelector('select');
        var inputCantidad = clon.querySelector('input');

        if (idMaterial) select.value = idMaterial;
        if (cantidad) inputCantidad.value = cantidad;

        clon.querySelector('.btn-quitar-material').addEventListener('click', function(e) {
            e.target.closest('.fila-material').remove();
        });

        document.getElementById('filas-materiales').appendChild(clon);
    }

    document.getElementById('btn-agregar-material').addEventListener('click', function() {
        agregarFilaMaterial();
    });

    // Si venimos de un error de validación con materiales ya elegidos, los prellena.
    // Si no, arranca con una fila vacía.
    const seleccionPrevia = @Html.Raw(Json.Serialize(
                                                        Model.MaterialesDisponibles.Select(m => new { id = m.IdMaterial, cantidad = m.Cantidad })));

    if (seleccionPrevia.length > 0) {
        seleccionPrevia.forEach(function(item) {
            agregarFilaMaterial(item.id, item.cantidad);
        });
    } else {
        agregarFilaMaterial();
    }
</script>