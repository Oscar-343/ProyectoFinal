@model ProyectoFinal.Models.Modelo

<div class="page-header">
    <h1 class="page-title">Eliminar modelo</h1>
    <p class="page-eyebrow">Esta acción no se puede deshacer</p>
</div>

<div class="detalle-box" style="max-width:340px;margin:0 auto">
    <div class="caja-peligro">⚠️ ¿Seguro que quieres eliminar este modelo?</div>

    <div class="card-modelo">
        <img src="@Model.Imagen" />
        <div class="cuerpo">
            <strong>@Model.Nombre</strong>
            <p>@Model.Descripcion</p>
        </div>
    </div>

    <form asp-action="Delete" method="post" style="margin-top:16px">
        <input type="hidden" asp-for="IdModelo" />
        <button type="submit" class="btn-peligro">Sí, eliminar</button>
        <a asp-action="Index" class="btn-secundario">Cancelar</a>
    </form>
</div>
